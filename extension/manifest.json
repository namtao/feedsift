{
  "manifest_version": 3,
  "name": "FeedSift",
  "version": "0.1.0",
  "description": "Sàng feed Facebook và X ngay khi bạn lướt: ẩn quảng cáo, video, gợi ý, bài hỏi Grok, và chấm điểm bài theo sở thích bằng LLM.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "FeedSift",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "webRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://gist.githubusercontent.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "content/filter.js"
      ],
      "css": [
        "content/filter.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
